{
  "hosting": {
    "site": "dungdanggi-make",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "*.py",
      "sounds.js",
      "brush-test.html",
      "tools/**",
      "_to_delete/**"
    ],
    "headers": [
      { "source": "**/*.@(wav|m4a|mp3|jpg|png|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
