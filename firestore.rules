rules_version = '2';
// 둥당기 만들기: 벗에게 나눈 작품 기록.
// 누구나 새로 맡기고 읽을 수 있지만, 한 번 맡긴 기록은 고치거나 지울 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /works/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if id.size() == 10
        && request.resource.data.keys().hasOnly(['w', 'v'])
        && request.resource.data.w is string
        && request.resource.data.w.size() < 400000
        && request.resource.data.v is int;
      allow update, delete: if false;
    }
  }
}
